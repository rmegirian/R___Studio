\newlabel{sec-scatterplots}{{}{13}{Scatter Plots}{subsection*.19}{}}
\BKM@entry{id=8,dest={73756273756273656374696F6E2A2E3233},srcline={814},srcfile={2E2F64657363726970746976655F616E645F6578706C6F7261746F72795F6F7574707574732E746578}}{5C3337365C3337375C303030525C303030655C303030615C303030645C303030695C3030306E5C303030675C3030305C3034305C303030735C303030635C303030615C303030745C303030745C303030655C303030725C3030305C3034305C303030705C3030306C5C3030306F5C303030745C30303073}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces A scatter plot showing a strong positive linear relationship between two variables. Points cluster tightly around the fitted line, indicating that values of one variable are highly predictable from the other. The shaded band represents the confidence interval around the fitted line, reflecting uncertainty in the estimated relationship.}}{14}{figure.caption.21}\protected@file@percent }
\newlabel{fig-scatter-linear}{{9}{14}{A scatter plot showing a strong positive linear relationship between two variables. Points cluster tightly around the fitted line, indicating that values of one variable are highly predictable from the other. The shaded band represents the confidence interval around the fitted line, reflecting uncertainty in the estimated relationship}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces A scatter plot showing a non-linear relationship between two variables. The curved fitted line indicates that the rate of change is not constant across the range of values, meaning a straight line would poorly describe the relationship.}}{14}{figure.caption.22}\protected@file@percent }
\newlabel{fig-scatter-curved}{{10}{14}{A scatter plot showing a non-linear relationship between two variables. The curved fitted line indicates that the rate of change is not constant across the range of values, meaning a straight line would poorly describe the relationship}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Reading scatter plots}{14}{subsubsection*.23}\protected@file@percent }
\newlabel{reading-scatter-plots}{{}{14}{Reading scatter plots}{subsubsection*.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces A scatter plot showing two distinct groups with different relationships between the same two variables. The steeper cluster of points indicates a more rapid rate of change, while the shallower cluster indicates a slower rate. When groups show different relationships like this, analysing them together as a single trend can be misleading, and the grouping variable should be accounted for in any subsequent analysis.}}{15}{figure.caption.24}\protected@file@percent }
\newlabel{fig-scatter-groups}{{11}{15}{A scatter plot showing two distinct groups with different relationships between the same two variables. The steeper cluster of points indicates a more rapid rate of change, while the shallower cluster indicates a slower rate. When groups show different relationships like this, analysing them together as a single trend can be misleading, and the grouping variable should be accounted for in any subsequent analysis}{figure.caption.24}{}}
