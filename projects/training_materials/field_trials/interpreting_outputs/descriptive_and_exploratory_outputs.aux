\@writefile{toc}{\contentsline {paragraph}{\nonumberline Normal example}{5}{paragraph*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Histogram of an approximately normal distribution, showing the mean, median and mode clustering around the centre of a symmetrical bell-shaped curve. This is the most commonly assumed distribution shape underlying statistical methods, making it an important pattern to recognise in your data and residuals.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig-hist-normal}{{4}{5}{Histogram of an approximately normal distribution, showing the mean, median and mode clustering around the centre of a symmetrical bell-shaped curve. This is the most commonly assumed distribution shape underlying statistical methods, making it an important pattern to recognise in your data and residuals}{figure.caption.9}{}}
\BKM@entry{id=4,dest={73756273656374696F6E2A2E3134},srcline={504},srcfile={2E2F64657363726970746976655F616E645F6578706C6F7261746F72795F6F7574707574732E746578}}{5C3337365C3337375C303030425C3030306F5C303030785C303030705C3030306C5C3030306F5C303030745C30303073}
\@writefile{toc}{\contentsline {paragraph}{\nonumberline Skewed example}{6}{paragraph*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces A histogram of a skewed distribution, where the longer tail pulls the mean away from the median and mode. This separation of the three measures is a key indicator of skewness and is important for determining which analytical methods are appropriate.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig-hist-skewed}{{5}{6}{A histogram of a skewed distribution, where the longer tail pulls the mean away from the median and mode. This separation of the three measures is a key indicator of skewness and is important for determining which analytical methods are appropriate}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{\nonumberline Bimodal example}{6}{paragraph*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\nonumberline Boxplots}{6}{subsection*.14}\protected@file@percent }
\newlabel{sec-boxplots}{{}{6}{Boxplots}{subsection*.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Histogram of a bimodal distribution showing two distinct peaks, suggesting the data may contain two subgroups with different underlying characteristics. Applying an analysis that assumes a single trend across all the data, such as comparing a single overall mean, could obscure these differences and lead to misleading conclusions.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig-hist-bimodal}{{6}{7}{Histogram of a bimodal distribution showing two distinct peaks, suggesting the data may contain two subgroups with different underlying characteristics. Applying an analysis that assumes a single trend across all the data, such as comparing a single overall mean, could obscure these differences and lead to misleading conclusions}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces A boxplot provides a concise visual summary of a variable's distribution. The central box spans the interquartile range (IQR), from the first quartile (Q1) to the third quartile (Q3), representing the middle 50\% of values. A line inside the box marks the median. The whiskers extend to the furthest values that fall within 1.5 times the IQR below Q1 and above Q3. values beyond this range are considered potential outliers and are plotted as individual points, indicating they may require further investigation. In this example, the relatively balanced spacing of the box and whiskers suggests that the data may follow a normal distribution.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig-box-anatomy}{{7}{8}{A boxplot provides a concise visual summary of a variable's distribution. The central box spans the interquartile range (IQR), from the first quartile (Q1) to the third quartile (Q3), representing the middle 50\% of values. A line inside the box marks the median. The whiskers extend to the furthest values that fall within 1.5 times the IQR below Q1 and above Q3. values beyond this range are considered potential outliers and are plotted as individual points, indicating they may require further investigation. In this example, the relatively balanced spacing of the box and whiskers suggests that the data may follow a normal distribution}{figure.caption.15}{}}
